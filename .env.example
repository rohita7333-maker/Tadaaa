# Shared MomentAsk Supabase project (same DB as web). anon key is public + RLS-protected.
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Next backend origin for secret-key routes (LAN dev IP or deployed URL). Not localhost on device.
EXPO_PUBLIC_API_BASE_URL=http://<your-mac-lan-ip>:3000
EXPO_PUBLIC_SITE_URL=http://<your-mac-lan-ip>:3000
