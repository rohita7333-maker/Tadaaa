# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://tadaaaa.app

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=TaDaaaa <noreply@tadaaaa.app>

# Cron authentication
CRON_SECRET=generate-a-random-string-here

# Analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tadaaaa.app

# Sentry (error + performance + replay; no-ops unless NODE_ENV=production)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
