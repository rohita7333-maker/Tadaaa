{
  "expo": {
    "name": "TaDaaaa",
    "slug": "tadaaaa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tadaaaa",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF8F0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.tadaaaa.mobile",
      "associatedDomains": [
        "applinks:tadaaaa.app"
      ]
    },
    "android": {
      "package": "app.tadaaaa.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#C4686D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tadaaaa.app",
              "pathPrefix": "/surprise"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "TaDaaaa needs access to your photos so you can add them to your surprise."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "TaDaaaa saves your finished collage to your photo library.",
          "savePhotosPermission": "TaDaaaa saves your finished collage to your photo library."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
