+/* ============================================================
+   P2-A — App-chrome atoms (ported from tadaaaa-editorial.html)
+
+   Dashboard, activity and settings chrome. Every rule below mirrors a named
+   rule in the mockup; the line reference is on the block. Prefix is `ed-` so
+   nothing collides with the Phase 0 atoms above or with shadcn.
+
+   Colour comes only from the eight editorial primitives. No literal hexes.
+   ============================================================ */
+
+/* --- buttons — mockup .btn / .btn-coral / .btn-ink / .btn-line (L55-66) --- */
+.ed-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  padding: 14px 30px;
+  border-radius: var(--r-pill);
+  font-size: 13px;
+  font-weight: 600;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s,
+    border-color 0.18s;
+  min-height: 44px;
+  white-space: nowrap;
+}
+.ed-btn:active {
+  transform: scale(0.98);
+}
+.ed-btn-coral {
+  background: var(--coral);
+  color: var(--white);
+}
+.ed-btn-ink {
+  background: var(--ink);
+  color: var(--paper);
+}
+.ed-btn-line {
+  background: var(--paper);
+  border: 1px solid var(--mist);
+  color: var(--ink);
+}
+.ed-btn-danger {
+  background: var(--paper);
+  border: 1px solid var(--coral-deep);
+  color: var(--coral-deep);
+}
+.ed-btn-sm {
+  padding: 9px 18px;
+  font-size: 11px;
+  min-height: 38px;
+}
+.ed-btn-block {
+  width: 100%;
+}
+.ed-btn:disabled,
+.ed-btn[aria-disabled="true"] {
+  opacity: 0.55;
+  cursor: not-allowed;
+}
+@media (hover: hover) and (pointer: fine) {
+  .ed-btn-coral:hover:not(:disabled) {
+    background: var(--coral-deep);
+    box-shadow: var(--sh-card);
+  }
+  .ed-btn-ink:hover:not(:disabled) {
+    background: #000;
+  }
+  .ed-btn-line:hover:not(:disabled),
+  .ed-btn-danger:hover:not(:disabled) {
+    border-color: var(--ink);
+  }
+  .ed-btn-danger:hover:not(:disabled) {
+    border-color: var(--coral-deep);
+    background: var(--chip-coral-bg);
+  }
+}
+
+/* --- text link — mockup .tlink / .tlink-ink (L67-71) --- */
+.ed-tlink {
+  color: var(--coral-deep);
+  font-weight: 600;
+  font-size: 14px;
+  letter-spacing: 0.01em;
+}
+.ed-tlink:hover {
+  text-decoration: underline;
+}
+
+/* --- page head — mockup .phead (L249-251) --- */
+.ed-phead {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 16px;
+  flex-wrap: wrap;
+  margin-bottom: 28px;
+}
+.ed-phead h1 {
+  font-size: 30px;
+}
+.ed-phead .ed-sub {
+  font-size: 14px;
+  color: var(--stone);
+  margin-top: 4px;
+}
+
+/* --- stat tiles — mockup .stats4 / .stat (L252-256) --- */
+.ed-stats {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
+  gap: 14px;
+  margin-bottom: 30px;
+}
+.ed-stat {
+  background: var(--paper);
+  border: 1px solid var(--mist);
+  border-radius: var(--r-md);
+  padding: 20px;
+  cursor: pointer;
+  transition: border-color 0.15s;
+  display: block;
+}
+@media (hover: hover) and (pointer: fine) {
+  .ed-stat:hover {
+    border-color: var(--ink);
+  }
+}
+.ed-stat .ed-v {
+  font-family: var(--head);
+  font-size: 32px;
+  line-height: 1.1;
+  color: var(--ink);
+  font-variant-numeric: tabular-nums;
+}
+.ed-stat .ed-l {
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--stone);
+  margin-top: 2px;
+}
+
+/* --- resume strip — mockup .resume (L257-259) --- */
+.ed-resume {
+  border: 1px solid var(--sand);
+  background: var(--pebble);
+  border-radius: var(--r-md);
+  padding: 16px 20px;
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  flex-wrap: wrap;
+  margin-bottom: 22px;
+}
+.ed-resume p {
+  flex: 1;
+  min-width: 200px;
+  font-size: 14px;
+  color: var(--ink);
+}
+
+/* --- two-column dashboard body — mockup .gr2 (L259) --- */
+.ed-gr2 {
+  display: grid;
+  grid-template-columns: 1.55fr 1fr;
+  gap: 22px;
+  align-items: start;
+}
+@media (max-width: 760px) {
+  .ed-gr2 {
+    grid-template-columns: 1fr;
+  }
+}
+
+/* --- panel — mockup .panel (L260-261) --- */
+.ed-panel {
+  background: var(--paper);
+  border: 1px solid var(--mist);
+  border-radius: var(--r-md);
+  padding: 22px;
+}
+.ed-panel > h2,
+.ed-panel > h3 {
+  font-size: 19px;
+  margin-bottom: 16px;
+  display: flex;
+  justify-content: space-between;
+  align-items: baseline;
+  gap: 12px;
+}
+
+/* --- surprise row — mockup .srow (L262-267) --- */
+.ed-srow {
+  display: flex;
+  gap: 14px;
+  align-items: center;
+  padding: 14px 0;
+  border-bottom: 1px solid var(--mist);
+  /* Not in the mockup: our rows carry a full-width disclosure drawer, which
+     needs a wrap opportunity. No row without a drawer ever wraps. */
+  flex-wrap: wrap;
+}
+.ed-srow:last-child,
+.ed-srow-list > *:last-child .ed-srow {
+  border-bottom: none;
+}
+.ed-srow .ed-th {
+  width: 60px;
+  height: 60px;
+  border-radius: var(--r-sm);
+  flex-shrink: 0;
+  background: var(--pebble) center / cover no-repeat;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+.ed-srow .ed-m {
+  flex: 1;
+  min-width: 0;
+}
+.ed-srow .ed-m h3,
+.ed-srow .ed-m h4 {
+  font-size: 17px;
+}
+.ed-srow .ed-meta {
+  font-size: 12px;
+  color: var(--stone);
+  display: flex;
+  gap: 10px;
+  flex-wrap: wrap;
+  align-items: center;
+  margin-top: 2px;
+}
+.ed-srow .ed-acts {
+  display: flex;
+  gap: 6px;
+  flex-shrink: 0;
+}
+/* Below ~520px the four 38px actions (170px) plus the 60px thumbnail leave the
+   title ~20px. Drop the actions onto their own line instead of letting the row
+   overflow: thumbnail + title on one line, actions beneath. */
+@media (max-width: 520px) {
+  .ed-srow .ed-m {
+    flex-basis: calc(100% - 74px);
+  }
+  .ed-srow .ed-acts {
+    width: 100%;
+    justify-content: flex-start;
+  }
+}
+
+/* --- status pill — mockup .stat-pill (L268-270) --- */
+.ed-pill {
+  font-size: 10px;
+  font-weight: 600;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  padding: 3px 9px;
+  border-radius: var(--r-pill);
+  border: 1px solid var(--mist);
+  color: var(--stone);
+  display: inline-flex;
+  align-items: center;
+  white-space: nowrap;
+}
+.ed-pill-live {
+  border-color: var(--coral);
+  color: var(--coral-deep);
+}
+.ed-pill-scheduled {
+  border-color: var(--sand);
+  color: var(--chip-muted-text);
+}
+.ed-pill-expired,
+.ed-pill-archived,
+.ed-pill-draft {
+  border-color: var(--mist);
+  color: var(--stone);
+}
+
+/* --- icon button — mockup .ib (L271-274) --- */
+.ed-ib {
+  width: 38px;
+  height: 38px;
+  border-radius: var(--r-sm);
+  border: 1px solid var(--mist);
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  color: var(--ink);
+  background: var(--paper);
+  flex-shrink: 0;
+  transition: border-color 0.15s, transform 0.16s ease;
+}
+.ed-ib:active {
+  transform: scale(0.96);
+}
+.ed-ib:disabled,
+.ed-ib[aria-disabled="true"] {
+  color: var(--sand-deep);
+  background: var(--pebble);
+  cursor: not-allowed;
+}
+@media (hover: hover) and (pointer: fine) {
+  .ed-ib:not(:disabled):not([aria-disabled="true"]):hover {
+    border-color: var(--ink);
+  }
+}
+.ed-ib svg {
+  width: 16px;
+  height: 16px;
+}
+
+/* --- activity feed item — mockup .feedi (L275-278) --- */
+.ed-feedi {
+  display: flex;
+  gap: 12px;
+  padding: 10px 0;
+  border-bottom: 1px solid var(--mist);
+  font-size: 14px;
+  color: var(--ink);
+  width: 100%;
+  text-align: left;
+  align-items: flex-start;
+}
+.ed-feedi:last-child {
+  border-bottom: none;
+}
+.ed-feedi .ed-t {
+  color: var(--stone);
+  font-size: 12px;
+  margin-top: 2px;
+}
+.ed-feedi .ed-dot {
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: var(--coral);
