+  flex-shrink: 0;
+}
+.ed-feedgroup {
+  font-size: 11px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--stone);
+  margin: 12px 0 4px;
+}
+
+/* --- empty state — mockup .empty (L279) --- */
+.ed-empty {
+  text-align: center;
+  padding: 64px 20px;
+  color: var(--stone);
+  font-size: 15px;
+}
+
+/* --- filter chip — mockup .chip (L283) --- */
+.ed-chip {
+  flex-shrink: 0;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 9px 18px;
+  border-radius: var(--r-pill);
+  border: 1px solid var(--mist);
+  background: var(--paper);
+  color: var(--stone);
+  font-size: 13px;
+  font-weight: 600;
+  min-height: 38px;
+  transition: border-color 0.15s, background 0.15s, color 0.15s,
+    transform 0.16s ease;
+}
+.ed-chip:active {
+  transform: scale(0.97);
+}
+.ed-chip-on {
+  background: var(--ink);
+  border-color: var(--ink);
+  color: var(--paper);
+}
+@media (hover: hover) and (pointer: fine) {
+  .ed-chip:not(.ed-chip-on):hover {
+    border-color: var(--ink);
+    color: var(--ink);
+  }
+}
+.ed-chiprow {
+  display: flex;
+  gap: 8px;
+  overflow-x: auto;
+  flex-wrap: wrap;
+  padding-bottom: 4px;
+  margin-bottom: 18px;
+}
+
+/* --- settings row — mockup .setrow (L406-410) --- */
+.ed-setrow {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  padding: 18px 0;
+  border-bottom: 1px solid var(--mist);
+  flex-wrap: wrap;
+}
+.ed-setrow:last-child {
+  border-bottom: none;
+}
+.ed-setrow .ed-m {
+  flex: 1;
+  min-width: 180px;
+}
+.ed-setrow .ed-m h2,
+.ed-setrow .ed-m h3 {
+  font-size: 15px;
+  font-family: var(--body);
+  font-weight: 600;
+  letter-spacing: 0;
+}
+.ed-setrow .ed-m p {
+  font-size: 13px;
+}
+.ed-setrow-danger .ed-m h2,
+.ed-setrow-danger .ed-m h3 {
+  color: var(--coral-deep);
+}
+
+/* --- toggle — mockup .sw (L343-348) --- */
+.ed-sw {
+  position: relative;
+  width: 46px;
+  height: 26px;
+  flex-shrink: 0;
+  display: inline-block;
+}
+.ed-sw input {
+  position: absolute;
+  opacity: 0;
+  width: 100%;
+  height: 100%;
+  cursor: pointer;
+  z-index: 2;
+  margin: 0;
+}
+.ed-sw .ed-tr {
+  position: absolute;
+  inset: 0;
+  background: var(--mist);
+  border-radius: 13px;
+  transition: background 0.18s;
+}
+.ed-sw .ed-tr::after {
+  content: "";
+  position: absolute;
+  top: 3px;
+  left: 3px;
+  width: 20px;
+  height: 20px;
+  border-radius: 50%;
+  background: var(--white);
+  box-shadow: var(--sh);
