+}
+.ed-sw input:checked + .ed-tr {
+  background: var(--ink);
+}
+.ed-sw input:checked + .ed-tr::after {
+  left: 23px;
+}
+.ed-sw input:focus-visible + .ed-tr {
+  outline: 2px solid var(--coral);
+  outline-offset: 2px;
+}
+
+/* --- avatar — mockup .avatar (L48) --- */
+.ed-avatar {
+  width: 36px;
+  height: 36px;
+  border-radius: 50%;
+  background: var(--ink);
+  color: var(--paper);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 13px;
+  font-weight: 600;
+  overflow: hidden;
+  flex-shrink: 0;
+}
