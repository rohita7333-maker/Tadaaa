{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/ai/draft-invite/route.ts": {
      "maxDuration": 30
    }
  },
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/expire-invites",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sweep-orphans",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/monthly-email",
      "schedule": "0 14 1 * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 14 * * 1"
    }
  ]
}
